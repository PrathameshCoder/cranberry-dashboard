generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String  @unique
  name   String?
  avatar String?

  passwordHash       String
  role               Role       @default(EMPLOYEE)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)

  sessions Session[]

  knowledgeItems KnowledgeItem[] @relation("UserKnowledgeItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model KnowledgeItem {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  summary String
  content String?
  tags    String[] @default([])
  impact  Impact   @default(LOW)

  authorId String @db.ObjectId

  author User @relation("UserKnowledgeItems", fields: [authorId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([impact])
  @@index([authorId])
}

model Attachment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // relation back to KnowledgeItem
  itemId String        @db.ObjectId
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  size     Int

  // Demo-friendly: store file inside Mongo as base64
  dataBase64 String

  createdAt DateTime @default(now())

  @@index([itemId])
}
